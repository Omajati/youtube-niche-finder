# Скопируйте этот файл в .env и впишите свои ключи. Файл .env в git не попадает.
# До 4 ключей от разных Google-аккаунтов через запятую, без пробелов.
# Когда у ключа заканчивается дневная квота, инструмент сам переходит на следующий.
YOUTUBE_API_KEYS=ключ1,ключ2,ключ3,ключ4

# Необязательные настройки (значения по умолчанию):
# MIN_DURATION_MIN=8              # минимальная длина ролика, минут
# SMALL_CHANNEL_MAX_SUBS=200000   # «малый канал» до стольких подписчиков
# BIG_CHANNEL_SUBS=1000000        # от стольких подписчиков канал считается крупным конкурентом
# NEW_CHANNEL_DAYS=90             # «новый канал» = первый ролик за последние N дней
# EXCLUDE_COUNTRIES=IN,PK,BD,NP,LK # каналы из этих стран не учитываются совсем
# MIN_VIEWS_EN=10000              # ролики с меньшим числом просмотров не считаются успешными
# MIN_VIEWS_ES=5000               # (рынки ES/DE/FR меньше, порог ниже; MIN_VIEWS задаёт один порог для всех)
# MIN_VIEWS_DE=5000
# MIN_VIEWS_FR=5000
# MIN_VIDEO_AGE_DAYS=14           # свежий ролик, ещё не набравший порог, не учитывается
# UPLOADS_CHECK_CHANNELS=40       # у скольких малых каналов смотреть последние ролики (1 единица квоты на канал)
# SEARCH_PUBLISHED_DAYS=180       # ищем ролики за последние N дней
# SEARCH_DURATIONS=medium,long    # medium = 4–20 мин, long = 20+ мин; каждый поиск стоит 100 единиц
# Пороги и веса удобнее менять в программе: «Настройки анализа» (сохраняются в data/settings.json и важнее этих строк)
# RATIO_TARGET=10                 # медиана «просмотры / подписчики» для максимума
# NEW_CHANNELS_TARGET=3
# BIG_SHARE_MAX=40
# SATURATION_LOW=2000
# SATURATION_HIGH=200000
# EVERGREEN_AGE_DAYS=60
# LOW_DATA_MIN_HITS=3
# VAULT_MIN_SCORE=65
# PORT=8766
